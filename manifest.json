{
  "manifest_version": 3,
  "name": "Babel Gold Drafting",
  "version": "0.1.24",
  "description": "Standalone Silver-to-Gold drafting assistant for Babel transcription jobs.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "dist/background/ai-broker.js"
  },
  "externally_connectable": {
    "ids": [
      "dldjgploldmldipplklepcpjdjhehald",
      "afpcopjodphibggidgicpjnkgnfhhemi"
    ]
  },
  "host_permissions": [
    "https://dashboard.babel.audio/*",
    "https://reviewgen.ovh/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://dashboard.babel.audio/*"
      ],
      "js": [
        "dist/content/audio-request-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dashboard.babel.audio/*"
      ],
      "js": [
        "dist/content/entry.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/vendor/ort/*.mjs",
        "dist/vendor/ort/*.wasm"
      ],
      "matches": [
        "https://dashboard.babel.audio/*"
      ]
    }
  ]
}
