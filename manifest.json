{
  "manifest_version": 3,
  "name": "Babel Gold Drafting",
  "version": "0.1.4",
  "description": "Standalone Silver-to-Gold drafting assistant for Babel transcription jobs.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://dashboard.babel.audio/*",
    "https://reviewgen.ovh/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://dashboard.babel.audio/*"
      ],
      "js": [
        "dist/content/entry.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
